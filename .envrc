# Loaded automatically by direnv when you cd into this repo (https://direnv.net).
# No secrets here: credentials come from `aws login` and live in ~/.aws, never in the repo.
export AWS_PROFILE=devops-lab      # named profile in ~/.aws/config
export AWS_REGION=us-east-2        # the Blank Slate project's Region (fixed by AWS for this project)
export AWS_DEFAULT_REGION=us-east-2
